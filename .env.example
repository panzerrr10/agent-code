# ===== 大模型 Provider 密钥（用哪家填哪家，只放后端，不会下发到浏览器）=====
# 这是模板文件，请复制为 .env 后填入真实密钥（.env 已被 .gitignore 忽略）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DASHSCOPE_API_KEY=sk-your-dashscope-key
ZHIPU_API_KEY=your-zhipu-key
OPENAI_API_KEY=sk-your-openai-key

# ===== RAG（可选）=====
# 不填则回退到 DASHSCOPE_API_KEY（RAG 默认锁死阿里云百炼）
# RAG_API_KEY=sk-your-rag-key
# RAG_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 数据库（MySQL，必需）=====
# 会话、消息、断点状态全部存 MySQL，**不再写本地 chat.db**。
# 首次部署先建库建账号：mysql -uroot -p < scripts/init_mysql.sql
# 然后初始化表结构：python scripts/init_db.py
#
# 方式一（推荐）：直接给完整连接串，优先级最高
# AGENT_DB_URL=mysql+pymysql://agent:你的密码@127.0.0.1:3306/agent_code?charset=utf8mb4
#
# 方式二：分项配置，程序自己拼
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=agent
MYSQL_PASSWORD=change-me-please
MYSQL_DATABASE=agent_code

# 从旧版本升级：把 data/chat.db 的历史数据搬到 MySQL（只读旧库，可重复执行）
#   python scripts/migrate_sqlite_to_mysql.py --dry-run   # 先看行数
#   python scripts/migrate_sqlite_to_mysql.py             # 真正写入

# ===== 访问令牌（最小鉴权）=====
# 所有 /api/*、/run*、/sessions* 等接口都要求请求头 X-Auth-Token。
# 不设置本项时，首次启动会自动生成 32 字节随机令牌并写入 data/auth_token（权限 0600）。
# 页面会自动注入令牌，浏览器里无需手工配置；用 curl / 脚本访问时才需要显式带上。
# AGENT_AUTH_TOKEN=

# ===== 代码执行沙箱（Docker）=====
# run_python / run_command 每次都用 `docker run --rm` 起临时容器，
# 并把当前项目根目录挂载为 /workspace（与文件工具看到的是同一份文件）。
# 需要先构建镜像：docker build -t agent-sandbox .
# AGENT_SANDBOX_IMAGE=agent-sandbox
# AGENT_SANDBOX_NETWORK=none    # 默认禁网（防数据外传）；需要 pip install 时改为 bridge
# AGENT_SANDBOX_MEMORY=512m
# AGENT_SANDBOX_CPUS=1
# AGENT_ALLOW_HOST_EXEC=0       # 置 1 才允许 Docker 不可用时在宿主机跑任意代码（风险自负）
# AGENT_TESTS_IN_SANDBOX=0      # 置 1 让 run_tests 也进沙箱（容器内用镜像自带依赖）

# ===== 执行策略（联网 / 安装 / 推送 / 评审跑测试）=====
# 也可以在界面 设置 → 执行策略 里逐项改（写进 data/policy.json，权限 600）。
# 环境变量的优先级**高于**界面设置；界面会标明哪一项被环境变量接管了。
#
# 默认值：
#   安装依赖 = 开（否则遇到 ModuleNotFoundError 就死，日常开发不可用）
#   联网     = 关（curl / wget / git fetch|pull|clone）
#   推送     = 关（git push）
#
# AGENT_ALLOW_PACKAGE_INSTALL=0   # 关掉装依赖，回到「一律硬拦」
# AGENT_ALLOW_NETWORK=1           # 允许联网（容器网络也是靠这一项/装依赖顶成 bridge）
# AGENT_ALLOW_GIT_PUSH=1          # 允许 git push（单独一项：它会把代码发到外部服务）
# AGENT_ALLOW_REVIEWER_TESTS=0    # 置 0 关掉「评审阶段自动跑测试」，回到纯静态审查
#
# ⚠️ 因为「安装依赖」默认开，sandbox_network() 默认返回 bridge ——
#    即**沙箱默认有网**。curl / git pull 仍在命令层被拦，但 run_python 里的
#    requests 能直接出网。要回到「默认禁网」：AGENT_SANDBOX_NETWORK=none

# ===== 代码库索引（repo map，可选）=====
# 把工作区的代码结构压成一段紧凑索引注入上下文，让 Agent 先知道「该看哪个文件」。
# 注意：对用户主目录这类「目录而非项目」不会建索引（避免把无关项目的路径送进模型）。
# AGENT_REPO_MAP=0                # 整体关掉
# AGENT_REPO_MAP_CHARS=8000       # 索引字符上限（每步都要重发，别贪大）

# ===== LLM 请求超时（可选）=====
# SDK 默认 600 秒；这里默认收到 120 秒，避免挂死请求占住会话。
# AGENT_LLM_TIMEOUT=120

# ===== 调试 / 其它（可选）=====
# 设为 1 才开启 Flask debug（默认关闭）
# FLASK_DEBUG=1
# 覆盖 SQLite 路径（测试或多环境隔离用）
# AGENT_DB_PATH=

# ===== CLI 覆盖项（可选）=====
# 仅用于命令行临时覆盖默认 provider 的 key / base_url / model
# API_KEY=
# BASE_URL=
# MODEL=
